# Copy this file to .streamlit/secrets.toml and fill in your API keys.
# secrets.toml is gitignored and should never be committed.
#
# On Streamlit Community Cloud, add these key-value pairs via
# App Settings → Secrets (no need for a local secrets.toml there).

OPENAI_API_KEY    = "sk-..."
ANTHROPIC_API_KEY = "sk-ant-..."
