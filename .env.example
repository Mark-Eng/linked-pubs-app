# ── Copy this file to .env and fill in your values ──────────────────────────

# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_database_name

# Table/column names — adjust to match your Laravel schema
# To find them, connect to MySQL and run: SHOW TABLES; then DESCRIBE <tablename>;
DB_PUBLICATIONS_TABLE=publications
DB_AUTHORS_TABLE=publication_authors
DB_AUTHORS_FK=publication_id
DB_AUTHOR_NAME_COL=author
DB_COUNTRY_COL=country
DB_COUNTRY_DELIMITER=;

# LLM provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# API keys (provide at least the one matching LLM_PROVIDER)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Models (defaults shown — change only if needed)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pipeline settings
ANN_TOP_K=100               # candidates retrieved by FAISS per query
LLM_TOP_K=20                # top candidates passed to LLM after stage-2
LLM_CONCURRENCY=10          # max parallel LLM API calls
OUTPUT_THRESHOLD=0.40       # minimum composite score to report

# Scoring weights (should sum to 1.0)
WEIGHT_AUTHOR=0.30
WEIGHT_TITLE=0.20
WEIGHT_LLM=0.35
WEIGHT_EMBEDDING=0.10
WEIGHT_YEAR=0.05

# Country signal modifiers
COUNTRY_OVERLAP_BONUS=0.05
COUNTRY_DISJOINT_PENALTY=-0.40

# Year gap settings
YEAR_GAP_THRESHOLD=8        # years beyond which a penalty applies
YEAR_GAP_PENALTY=0.15

# Author matching
AUTHOR_MATCH_THRESHOLD=0.88 # Jaro-Winkler threshold (0–1)

# Stage-2 pre-filter for LLM (pair must exceed this on author OR title)
LLM_PREFILTER_THRESHOLD=0.15
